<<jump TutorialFuckUpReroute>>

===

title: TutorialFuckUpReroute
position: 414,45
---

/// This node makes it so tutorial lines continue as intended, going back to the step the player was in before they fucked up

<<if $nextTutorialStep== 1>>
    <<jump TutorialStep_1_OpenFridge>>
<<elseif $nextTutorialStep == 2>>
    <<jump TutorialStep_2_GrabBread>>
<<elseif $nextTutorialStep == 3>>
    <<jump TutorialStep_3_PlaceBread>>
<<elseif $nextTutorialStep == 4>>
    <<jump TutorialStep_4_RotateBread>>
<<elseif $nextTutorialStep == 5>>
    <<jump TutorialStep_5_GrabMeat>>
<<elseif $nextTutorialStep == 6>>
    <<jump TutorialStep_6_CookMeat>>
<<elseif $nextTutorialStep == 7>>
    <<jump TutorialStep_7_PlaceMeat>>
<<elseif $nextTutorialStep == 8>>
    <<jump TutorialStep_8_BuildBurger>>
<<elseif $nextTutorialStep == 9>>
    <<jump TutorialStep_9_PlaceBurger>>
<<elseif $nextTutorialStep == 10>>
    <<jump TutorialStep_10_GoToTable>>
<<else>>
    <<jump TutorialEnd>>
<<endif>>
===

